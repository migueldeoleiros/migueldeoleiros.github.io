---
import { Icon } from 'astro-icon/components';
import type { LinkIcon, SocialLink } from '../data/site';

interface HeroCopy {
  title: string;
  tagline: string;
  invertTitle: string;
}

interface Props {
  copy: HeroCopy;
  links: SocialLink[];
}

const { copy, links } = Astro.props;

const iconMap: Record<LinkIcon, string> = {
  globe: 'lucide:globe',
  mail: 'lucide:mail',
  github: 'simple-icons:github',
  linkedin: 'simple-icons:linkedin',
};
---

<section class="hero-stage" aria-labelledby="hero-title">
  <div
    class="hero-particles"
    data-particle-text={copy.title}
    data-particle-alt-text={copy.invertTitle}
  >
    <div class="hero-particles-stage">
      <canvas class="hero-particles-canvas" data-particle-canvas aria-hidden="true"></canvas>
    </div>
    <div class="hero-particles-copy">
      <h1 id="hero-title" class="hero-particles-title" data-particle-title>{copy.title}</h1>
      <p class="hero-tagline">{copy.tagline}</p>
      <ul class="link-list" aria-label="Primary links">
        {
          links.map(({ label, href, icon }) => {
            const iconName = iconMap[icon];
            return (
              <li>
                <a class="link-pill" href={href} aria-label={label} title={label}>
                  <span class="link-icon" aria-hidden="true">
                    <Icon name={iconName} size={18} />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
